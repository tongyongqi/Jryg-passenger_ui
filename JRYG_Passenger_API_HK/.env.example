# ============================================================
# 香港接口自动化环境变量配置模板
# ============================================================
# 使用方式：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 修改 .env 中的值为你需要的环境配置
#   3. .env 已在 .gitignore 中，不会被提交
#
# 也可以直接在终端 export 环境变量：
#   export HK_PASSENGER_MOBILE=your_mobile
# ============================================================

# ---------- 乘客端 ----------
# 乘客端 API 基地址
HK_API_BASE_URL=http://app-client-test.sunlightmobility.hk
# 乘客端测试手机号
HK_PASSENGER_MOBILE=11018251727
# 乘客端测试验证码（测试环境固定值）
HK_PASSENGER_CAPTCHA=123456

# ---------- 司机端 ----------
# 司机端 API 基地址
HK_DRIVER_API_BASE_URL=http://driver-test.sunlightmobility.hk
# 司机端测试手机号
HK_DRIVER_MOBILE=11000005
# 司机端测试验证码
HK_DRIVER_CAPTCHA=123456
# 司机端定位坐标
HK_DRIVER_LATITUDE=22.277409
HK_DRIVER_LONGITUDE=114.188752

# ---------- 搜索/路线 ----------
# 起终点搜索关键词
HK_BEGIN_SEARCH_KEYWORD=銅鑼灣
HK_END_SEARCH_KEYWORD=香港
# 搜索定位坐标
HK_SEARCH_LATITUDE=22.278893
HK_SEARCH_LONGITUDE=114.180418

# ---------- 账单 ----------
# 订单金额（原两文件不一致: "5" vs "88"，已统一）
HK_ORDER_AMOUNT=5
HK_OTHER_AMOUNT=0

# ---------- 安全/密钥（敏感信息，请勿提交真实值） ----------
# 签名密钥（乘客端和司机端共用）
HK_SIGN_KEY=RCY9H4c9Cc9z6KaKrunTToWsjCERRexY
# Redis 连接
HK_REDIS_HOST=172.31.104.4
HK_REDIS_PORT=6379
HK_REDIS_PASSWORD=ygcx_test2@wqBEUSwzxmDv8hpO
HK_REDIS_DB=8
# Socket 网关
HK_SOCKET_GATEWAY_HOST=43.128.0.173
HK_SOCKET_GATEWAY_PORT=9527

# ---------- 通用 ----------
# 区号
HK_AREA_CODE=+852
# 城市 ID
HK_CITY_ID=514
# 请求超时（秒）
HK_REQUEST_TIMEOUT=15

# ============================================================
# 大陆环境变量配置模板
# ============================================================
# 使用方式：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 修改 .env 中的值为你需要的环境配置
#   3. .env 已在 .gitignore 中，不会被提交
#
# 也可以直接在终端 export 环境变量：
#   export CN_REDIS_ENV=test6
# ============================================================

# ---------- 大陆 Redis ----------
# 当前环境标识: test6（大陆-test6） / pre（大陆-pre）
CN_REDIS_ENV=test6
